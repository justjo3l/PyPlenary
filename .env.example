DJANGO_DEVELOPMENT=1
DEBUG_MODE=1
SECRET_KEY=replace-me-in-production
COUNCIL_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL production settings. Leave unset for local SQLite development.
PGHOST=
PGDATABASE=
PGUSER=
PGPORT=5432
DBPASS=
PGSSLMODE=require

# Redis is required for multi-process production WebSocket fanout.
REDIS_URL=

# Email. Local development uses the console backend by default.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_PORT=465
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

REGO_OPEN=0
USER_TEMP_PASSWORD=replace-me-in-production

PYPLENARY_NAVBAR_NAME=PyPlenary
PYPLENARY_SITE_NAME=PyPlenary
PYPLENARY_SITE_TAGLINE=
PYPLENARY_AGENDA_URI=
PYPLENARY_REPORTS_URI=
PYPLENARY_POLICIES_URI=
PYPLENARY_SOCIALS_URI=
PYPLENARY_NODES_URI=
PYPLENARY_FACEBOOK_GROUP=
PYPLENARY_TZ=Australia/Melbourne
PYPLENARY_ADMIN_NAME=Joel Jose
PYPLENARY_ADMIN_EMAIL=
PYPLENARY_SUPPORT_EMAIL=
LOADERIO_TOKEN=
