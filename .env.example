DJANGO_DEVELOPMENT=1
DEBUG_MODE=1
SECRET_KEY=replace-me-in-production
COUNCIL_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL production settings. Leave unset for local SQLite development.
PGHOST=
PGDATABASE=
PGUSER=
PGPORT=5432
DBPASS=
PGSSLMODE=require

# Redis is required for multi-process production WebSocket fanout.
REDIS_URL=

# Email. Local development uses the console backend by default.
EMAIL_PROVIDER=gmail_api
EMAIL_BACKEND=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_SEND_URL=https://gmail.googleapis.com/gmail/v1/users/me/messages/send
GMAIL_API_TIMEOUT=10
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT=10
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_SSL=0
EMAIL_USE_TLS=1
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=amsaassistant@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=amsaassistant@gmail.com

REGO_OPEN=0
USER_TEMP_PASSWORD=replace-me-in-production

PYPLENARY_NAVBAR_NAME=PyPlenary
PYPLENARY_SITE_NAME=PyPlenary
PYPLENARY_SITE_TAGLINE=
